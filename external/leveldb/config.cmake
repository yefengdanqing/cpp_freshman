# 要求使用 C++17
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

include(ExternalProject)

# 外部依赖根目录
set(EXTERNAL_PREFIX ${CMAKE_BINARY_DIR}/external)
set(EXTERNAL_LEVELDB_ROOT ${EXTERNAL_PREFIX}/leveldb)

# LevelDB Git 源信息
set(LEVELDB_GIT_URL https://github.com/google/leveldb.git)
set(LEVELDB_GIT_TAG main)

# 安装输出路径
set(LEVELDB_INSTALL_PREFIX ${EXTERNAL_LEVELDB_ROOT})
set(LEVELDB_LIB_DIR       ${LEVELDB_INSTALL_PREFIX}/lib)
set(LEVELDB_INCLUDE_DIR   ${LEVELDB_INSTALL_PREFIX}/include)

# 如果没有加入CMAKE_PREFIX_PATH，则添加（用于 find_package 等机制）
list(FIND CMAKE_PREFIX_PATH ${EXTERNAL_LEVELDB_ROOT} _DEP_INDEX)
if (_DEP_INDEX EQUAL -1)
    list(APPEND CMAKE_PREFIX_PATH ${EXTERNAL_LEVELDB_ROOT})
endif()

# ExternalProject_Add 构建 leveldb
ExternalProject_Add(LEVELDB
    PREFIX ${EXTERNAL_LEVELDB_ROOT}
    GIT_REPOSITORY ${LEVELDB_GIT_URL}
    GIT_TAG ${LEVELDB_GIT_TAG}
    SOURCE_DIR ${EXTERNAL_LEVELDB_ROOT}/src/LEVELDB
    BINARY_DIR ${EXTERNAL_LEVELDB_ROOT}/src/LEVELDB/build
    INSTALL_DIR ${LEVELDB_INSTALL_PREFIX}
    CMAKE_ARGS
        -DCMAKE_INSTALL_PREFIX=${LEVELDB_INSTALL_PREFIX}
        -DCMAKE_INSTALL_LIBDIR=lib
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON
        -DBUILD_SHARED_LIBS=ON
        -DLEVELDB_BUILD_TESTS=OFF
        -DLEVELDB_BUILD_BENCHMARKS=OFF
        -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
        -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
        -DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}
        -DCMAKE_C_FLAGS=${CMAKE_C_FLAGS}
        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
    BUILD_BYPRODUCTS ${LEVELDB_LIB_DIR}/libleveldb.so
)

# 指定头文件和库搜索路径
include_directories(${LEVELDB_INCLUDE_DIR})
link_directories(${LEVELDB_LIB_DIR})

# 引入 libleveldb.so 为 IMPORTED 库
add_library(leveldb_leveldb SHARED IMPORTED GLOBAL)
set_property(TARGET leveldb_leveldb PROPERTY IMPORTED_LOCATION ${LEVELDB_LIB_DIR}/libleveldb.so)
add_dependencies(leveldb_leveldb LEVELDB)

# 添加到通用变量
set(LIB_BIBRARY
    ${LEVELDB_LIB_DIR}/libleveldb.so
    ${LIB_BIBRARY})
set(LIB_DEPENDS
    leveldb_leveldb
    ${LIB_DEPENDS})
