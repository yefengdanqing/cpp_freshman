        OUTPUT ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_types.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_types.cpp
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_constants.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_constants.cpp
