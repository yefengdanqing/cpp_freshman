#https://google.github.io/flatbuffers/flatbuffers_guide_use_cpp.html
macro(add_flatbuffers_target target_name fb_outdir fbs_file fbs_prefix)
    set(outfile ${fb_outdir}/${fbs_prefix}_generated.h)
    set(binary_outfile ${fb_outdir}/${fbs_prefix}.bfbs)
    add_custom_target(${target_name} ALL
            BYPRODUCTS ${outfile} ${binary_outfile}
            COMMAND flatbuffers::flatc --cpp --scoped-enums --reflect-names --gen-object-api
            -o ${fb_outdir}
            ${fbs_file}
            COMMAND flatbuffers::flatc --binary --schema
            -o ${fb_outdir}
            ${fbs_file}
            DEPENDS ${fbs_file})
endmacro(add_flatbuffers_target)

set(ns saas)
execute_process(COMMAND mkdir -p ${PROJECT_BINARY_DIR}/gen/flatbuffers/cpp/${ns})
message("flatbuffers out directory : ${PROJECT_BINARY_DIR}/gen/flatbuffers/cpp/${ns}")
set(fb_outdir ${PROJECT_BINARY_DIR}/gen/flatbuffers/cpp/${ns})

