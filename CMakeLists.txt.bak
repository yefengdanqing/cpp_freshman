add_custom_command(
        OUTPUT ${PROJECT_BINARY_DIR}/gen/thrift/cpp/enum/enum_types.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/enum/enum_types.cpp
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/enum/enum_constants.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/enum/enum_constants.cpp
        COMMAND thrift::thrift -gen cpp:cob_style,moveable_types
        -out ${PROJECT_BINARY_DIR}/gen/thrift/cpp/enum
        ${ADSERVER_ROOT_DIR}/common/thrift/enum.thrift
        DEPENDS ${ADSERVER_ROOT_DIR}/common/thrift/enum.thrift)

add_custom_command(
        OUTPUT ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_package_info_types.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_package_info_types.cpp
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_package_info_constants.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_package_info_constants.cpp
        COMMAND thrift::thrift -v -gen cpp:cob_style,moveable_types
        -out ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs
        ${ADSERVER_ROOT_DIR}/recommend_protocols/rs_package_info.thrift
        DEPENDS ${ADSERVER_ROOT_DIR}/recommend_protocols/rs_package_info.thrift)

add_custom_command(
        OUTPUT ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_demand_context_types.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_demand_context_types.cpp
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_demand_context_constants.h
        ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs/rs_demand_context_constants.cpp
        COMMAND thrift::thrift -v -gen cpp:cob_style,moveable_types
        -out ${PROJECT_BINARY_DIR}/gen/thrift/cpp/rs
        -I ${ADSERVER_ROOT_DIR}/recommend_protocols
        ${ADSERVER_ROOT_DIR}/recommend_protocols/rs_demand_context.thrift
        DEPENDS ${ADSERVER_ROOT_DIR}/recommend_protocols/rs_demand_context.thrift
        ${ADSERVER_ROOT_DIR}/recommend_protocols/rs_package_info.thrift)


