# close ranker_service ranker_bench compile
option(BUILD_RANKER_SERVICE "Build ranker programs" ON)
if (${BUILD_RANKER_SERVICE})
    ADD_EXECUTABLE(ranker_service src/main.cpp ${PROTOCOLS} ${DIR_RANKER_SRCS} ${COMMON_SRCS})
    add_dependencies(ranker_service THRIFT_CODEGEN
            flatbuffers_reflection_cpp
            flatbuffers_adv_offer_cpp
            saas_rs_feature_proto
            saas_rs_sdk_feature_proto
            stdrank_pb
            feature_extractor_pb
            feature_generator_server_pb
            model_inference_pb
            ${PB_TARGETS}
            meta_sample_proto
            algo_trace_info
            unify_feature)

    target_compile_options(ranker_service PRIVATE -funroll-loops -march=skylake)

    TARGET_INCLUDE_DIRECTORIES(ranker_service PRIVATE
            ${ML_UNITY_INCLUDE_DIR}
            ${DBG_MACRO_INCLUDE_DIR}
            ${BDE_INCLUDE_DIR}/bsl)

    if (DEFINED SPDLOG_ACTIVE_LEVEL)
        target_compile_definitions(ranker_service PRIVATE -DSPDLOG_ACTIVE_LEVEL=${SPDLOG_ACTIVE_LEVEL})
    endif ()

    if (NOT CMAKE_BUILD_TYPE STREQUAL "Asan")
        TARGET_LINK_LIBRARIES(
                ranker_service
                jemalloc::jemalloc
        )
    endif ()

    TARGET_LINK_LIBRARIES(ranker_service ${RANKER_LIBRARIES})
    ADD_CUSTOM_COMMAND(
            TARGET ranker_service
            POST_BUILD
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/conf
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/log
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/*.conf ${RANKER_BINARY_DIR}/conf/
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/gflags/ ${RANKER_BINARY_DIR}/conf/gflags
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/*.ini ${RANKER_BINARY_DIR}/conf/
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/*.json ${RANKER_BINARY_DIR}/conf/
            COMMAND rm -rf ${RANKER_BINARY_DIR}/output
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output/bin
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output/conf
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output/log
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output/lib
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output/script
            COMMAND mkdir -p ${RANKER_BINARY_DIR}/output/fbs_data
            COMMAND cp -rf ${RANKER_BINARY_DIR}/ranker_service ${RANKER_BINARY_DIR}/output/bin
            COMMAND cp -rf ${fb_outdir}/* ${RANKER_BINARY_DIR}/output/conf
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/*.conf ${RANKER_BINARY_DIR}/output/conf/
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/gflags/ ${RANKER_BINARY_DIR}/output/conf/gflags
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/exps/ ${RANKER_BINARY_DIR}/output/conf/exps
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/log.ini ${RANKER_BINARY_DIR}/output/conf/log.ini
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/*.json ${RANKER_BINARY_DIR}/output/conf/
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/conf/*.yaml ${RANKER_BINARY_DIR}/output/conf/
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/script/* ${RANKER_BINARY_DIR}/output/script/
            COMMAND cp -rf ${ADSERVER_ROOT_DIR}/tools/supervise ${RANKER_BINARY_DIR}/output/supervise.ranker_service
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/script/Makefile ${RANKER_BINARY_DIR}/output/Makefile
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/run ${RANKER_BINARY_DIR}/output/run
            COMMAND cp -rf ${RANKER_SOURCE_DIR}/op_ranker_service.sh ${RANKER_BINARY_DIR}/output/op_ranker_service.sh
            COMMAND python ${RANKER_SOURCE_DIR}/script/copy_depends.py ${RANKER_BINARY_DIR}/ranker_service -E -I libresolv.so:libpthread.so:libdl.so:librt.so:libm.so:libc.so:ld-linux-x86-64.so -o ${RANKER_BINARY_DIR}/output/lib
            COMMAND python ${RANKER_SOURCE_DIR}/script/patchelf.py ${RANKER_BINARY_DIR}/output/bin/ranker_service
    )
endif ()

